# Backend environment (copy to backend/.env)

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/billing_software
JWT_SECRET=replace-with-at-least-32-char-random-secret
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_DAYS=30
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=40
MONGO_MAX_POOL=20
MONGO_MIN_POOL=2
MONGO_SLOW_MS=200
# MONGO_DEBUG=true
# REDIS_URL=redis://localhost:6379
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_KEY=separate-from-jwt-recommended
JOB_POLL_MS=5000
JSON_BODY_LIMIT=2mb
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# SaaS commercial gates
# Development: leave false (shadow logs). Production: MUST be true.
# ---------------------------------------------------------------------------

# Refuse API calls to modules the company's plan does not include.
MODULE_GATE_ENFORCE=false

# Refuse a login from a computer beyond the licence's maxDevices.
DEVICE_BINDING_ENFORCE=false

# Refuse new sales invoices once the plan's monthly quota is spent.
# Also used for user-seat checks on admin user create.
PLAN_LIMIT_ENFORCE=false

# Local development only — lets the subscription/licence middleware be skipped.
# NEVER set this on a customer build.
ALLOW_SUBSCRIPTION_BYPASS=false

# Force subscription/licence checks even in development (overrides the bypass).
ENFORCE_SUBSCRIPTION=false

# Public self-serve signup (creates a free company). Keep false for SaaS selling.
ALLOW_PUBLIC_REGISTER=false

# Dunning: days after expiry before auto-suspend (default 7 = grace window)
DUNNING_GRACE_DAYS=7
# How often to run dunning sweep (ms). 0 disables. Default 6 hours.
DUNNING_INTERVAL_MS=21600000

# ---------------------------------------------------------------------------
# Email (optional). Without SMTP, invites/resets/dunning log to console.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Textile ERP <noreply@example.com>"
