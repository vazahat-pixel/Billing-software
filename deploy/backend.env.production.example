# Production template — copy to backend/.env on the VPS
# Do NOT commit real secrets.

NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/billing_software
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GENERATE_A_REAL_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_DAYS=30
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=40
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_KEY=separate-from-jwt-recommended
LOG_LEVEL=info

# ---- SaaS / commercial (safe defaults for go-live) ----
# Keep false unless you intentionally open self-serve signup.
ALLOW_PUBLIC_REGISTER=false
ALLOW_SUBSCRIPTION_BYPASS=false
ENFORCE_SUBSCRIPTION=true

# Before setting the next two to true, run ONCE:
#   node scripts/grandfatherLegacyTenants.js
# Existing tenants stay legacy_open and will NOT be hard-blocked.
MODULE_GATE_ENFORCE=false
PLAN_LIMIT_ENFORCE=false
DEVICE_BINDING_ENFORCE=false

DUNNING_GRACE_DAYS=7
DUNNING_INTERVAL_MS=21600000

# ---- Payments (optional) ----
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=xxx

# ---- Email (optional but recommended) ----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Textile ERP <noreply@yourdomain.com>"
